---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateTime } from '../../lib/astro/utils';
import { getEvents, getSettings } from '../../lib/astro/api';

const settings = await getSettings();
const events = (await getEvents()) as Array<Record<string, string>>;
---

<BaseLayout title="Events" description="Upcoming events and happenings" site={Astro.site}>
  <div class="container">
    <h1 class="section-title">Events</h1>
    {events.length === 0 ? (
      <p>No upcoming events.</p>
    ) : (
      <div class="card-grid">
        {events.map((event) => (
          <a href={`/events/${event.id}`} class="card">
            <h3>{event.title}</h3>
            {event.startDateTime && <p class="date">{formatDateTime(event.startDateTime)}</p>}
            {event.location && <p>{event.location}</p>}
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
