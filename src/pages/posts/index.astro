---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/astro/utils';
import { getPosts, getSettings } from '../../lib/astro/api';

const settings = await getSettings();
const posts = (await getPosts()) as Array<Record<string, string>>;
---

<BaseLayout title="Posts" description="Latest news and updates" site={Astro.site}>
  <div class="container">
    <h1 class="section-title">Posts</h1>
    {posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <div class="card-grid">
        {posts.map((post) => (
          <a href={`/posts/${post.slug}`} class="card">
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            {post.publishedAt && <p class="date">{formatDate(post.publishedAt)}</p>}
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
