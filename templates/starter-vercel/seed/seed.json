{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Starter Vercel",
		"description": "Opinionated local-business starter for EmDash on Vercel",
		"author": "EmDash"
	},

	"settings": {
		"title": "Neighborhood Service Co.",
		"tagline": "Fast local-business website your team can update without WordPress"
	},

	"collections": [
		{
			"slug": "posts",
			"label": "Updates",
			"labelSingular": "Update",
			"supports": ["drafts", "revisions", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Summary",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": ["drafts", "revisions", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],

	"taxonomies": [
		{
			"name": "category",
			"label": "Topics",
			"labelSingular": "Topic",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{ "slug": "news", "label": "News" },
				{ "slug": "seasonal", "label": "Seasonal" }
			]
		}
	],

	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{ "type": "custom", "label": "Home", "url": "/" },
				{ "type": "custom", "label": "About", "url": "/about" },
				{ "type": "custom", "label": "Updates", "url": "/posts" }
			]
		}
	],

	"widgetAreas": [],

	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Use this page to explain who you help, what makes your business trustworthy, and how local customers can get started."
								}
							]
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-1",
				"slug": "welcome",
				"status": "published",
				"data": {
					"title": "Welcome",
					"excerpt": "Start here. Replace this sample update with your business's first real announcement.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This starter is tuned for local-business sites. Keep public pages fast with Astro, let staff edit content in the admin, and skip the plugin sprawl of classic WordPress installs."
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "Next steps" }]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Update your site title, edit the About page, add your services or announcements, and deploy to Vercel with Turso and object storage when ready."
								}
							]
						}
					]
				},
				"taxonomies": {
					"category": ["news"]
				}
			}
		]
	}
}
