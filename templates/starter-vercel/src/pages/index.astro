---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<section class="hero">
		<p class="eyebrow">Fast local-business site</p>
		<h1>{siteTitle}</h1>
		<p class="lead">{siteTagline}</p>
		<div class="cta-row">
			<a class="button primary" href="/_emdash/admin">Open admin</a>
			<a class="button secondary" href="/about">Edit about page</a>
		</div>
	</section>

	<section class="grid-section">
		<div class="card">
			<h2>Built for owners and staff</h2>
			<p>Update hours, services, staff bios, simple pages, and blog-style updates without touching WordPress.</p>
		</div>
		<div class="card">
			<h2>Astro-fast public site</h2>
			<p>Visitors get a fast front-end while editors keep a friendly admin for day-to-day changes.</p>
		</div>
		<div class="card">
			<h2>Simple hosting path</h2>
			<p>Develop locally with SQLite. Deploy to Vercel with Turso and object storage when ready.</p>
		</div>
	</section>

	<section>
		<h2>Recent updates</h2>
		{
			posts.length === 0 ? (
				<p>
					No updates yet. <a href="/_emdash/admin/content/posts/new">Create one</a>.
				</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li class="post-card">
							<a href={`/posts/${post.id}`}>
								<h3>{post.data.title}</h3>
							</a>
							{post.data.excerpt && <p>{post.data.excerpt}</p>}
							{post.data.publishedAt && (
								<time datetime={post.data.publishedAt.toISOString()}>
									{post.data.publishedAt.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							)}
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.hero {
		padding: 4rem 0 2rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		color: #555;
	}

	h1 {
		font-size: clamp(2.5rem, 5vw, 4.25rem);
		line-height: 1.05;
		margin: 0.5rem 0 1rem;
	}

	.lead {
		font-size: 1.125rem;
		max-width: 42rem;
		color: #444;
	}

	.cta-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 1.1rem;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid #111;
	}

	.button.primary {
		background: #111;
		color: white;
	}

	.button.secondary {
		background: white;
		color: #111;
	}

	.grid-section {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		margin: 2rem 0 3rem;
	}

	.card,
	.post-card {
		border: 1px solid #e5e5e5;
		border-radius: 1rem;
		padding: 1rem;
		background: white;
	}

	.post-list {
		display: grid;
		gap: 1rem;
		padding: 0;
		list-style: none;
	}
</style>
